{
	admin off
	auto_https off
	persist_config off
}

:{$GATEWAY_PORT:8080} {
	bind {$GATEWAY_BIND:0.0.0.0}
	route {
		header {
			Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy same-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		import public-access.caddy
		request_body /api/* {
			max_size 32KiB
		}
		reverse_proxy /api/* {$API_UPSTREAM:api:3000} {
			header_up -Authorization
		}
		@hidden path_regexp (^|/)\.
		respond @hidden 404
		root * "{$WEB_ROOT:/srv}"
		try_files {path} /index.html
		file_server
	}
}
