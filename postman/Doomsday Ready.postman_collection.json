                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 201', function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "pm.collectionVariables.set('cinemaId', pm.response.json().id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Quote 44 seats",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/cinemas/{{cinemaId}}/booking?groupSize=44"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Finds the fewest bundles that fit', function () {",
                      "  const quote = pm.response.json();",
                      "  pm.expect(quote.possible).to.equal(true);",
                      "  pm.expect(quote.totalBundles).to.equal(4);",
                      "  pm.expect(quote.bundles.reduce((total, b) => total + b.size * b.quantity, 0)).to.equal(44);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Park Cinema · 4, 6 seats",
          "item": [
            {
              "name": "Add Park Cinema",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/cinemas",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Park Cinema {{run}}\",\n  \"bundleSizes\": [\n    4,\n    6\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.variables.set('run', Date.now().toString());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 201', function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
