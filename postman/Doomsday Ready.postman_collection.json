{
  "info": {
    "name": "Doomsday Ready",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the collection in order against a local API. It creates two movies and four cinemas with timestamped names. IDs are captured after each creation. Change baseUrl to target another instance."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Movie library",
      "item": [
        {
          "name": "Add a prerequisite",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movies",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prologue {{run}}\",\n  \"releaseYear\": 2010,\n  \"runtime\": 95\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('run', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('firstId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add its sequel",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movies",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finale {{run}}\",\n  \"releaseYear\": 2020,\n  \"runtime\": 120,\n  \"prerequisites\": [\n    {{firstId}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('run', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('finaleId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List movies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Both movies are in the library', function () {",
                  "  const ids = pm.response.json().map(movie => movie.id);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('firstId')));",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('finaleId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark the prerequisite as watched",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/movies/{{firstId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"watched\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Watched status was saved', function () {",
                  "  pm.expect(pm.response.json().watched).to.equal(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject a circular dependency",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/movies/{{firstId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    {{finaleId}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Reports a prerequisite cycle', function () {",
                  "  pm.expect(pm.response.json().code).to.equal('CIRCULAR_DEPENDENCY');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the rewatch plan",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movies/{{finaleId}}/rewatch-order"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Only the watched prerequisite appears', function () {",
                  "  const plan = pm.response.json();",
                  "  pm.expect(plan.movies.map(movie => movie.id)).to.deep.equal([Number(pm.collectionVariables.get('firstId'))]);",
                  "  pm.expect(plan.watchedCount).to.equal(1);",
                  "  pm.expect(plan.unwatchedRuntime).to.equal(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Party bookings",
      "item": [
        {
          "name": "Star Cinema · 1, 3, 4 seats",
          "item": [
            {
              "name": "Add Star Cinema",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/cinemas",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Star Cinema {{run}}\",\n  \"bundleSizes\": [\n    1,\n    3,\n    4\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.variables.set('run', Date.now().toString());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 201', function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "pm.collectionVariables.set('cinemaId', pm.response.json().id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List cinemas",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/cinemas"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Cinema lists its available bundles', function () {",
                      "  const cinema = pm.response.json().find(item => item.id === Number(pm.collectionVariables.get('cinemaId')));",
                      "  pm.expect(cinema.bundles.map(bundle => bundle.size)).to.have.members([1, 3, 4]);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Quote 6 seats",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/cinemas/{{cinemaId}}/booking?groupSize=6"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Finds the fewest bundles that fit', function () {",
                      "  const quote = pm.response.json();",
                      "  pm.expect(quote.possible).to.equal(true);",
                      "  pm.expect(quote.totalBundles).to.equal(2);",
                      "  pm.expect(quote.bundles.reduce((total, b) => total + b.size * b.quantity, 0)).to.equal(6);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Metro Cinema · 2, 5 seats",
          "item": [
            {
              "name": "Add Metro Cinema",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/cinemas",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Metro Cinema {{run}}\",\n  \"bundleSizes\": [\n    2,\n    5\n  ]\n}",
