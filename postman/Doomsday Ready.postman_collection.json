                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns HTTP 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Reports an impossible booking', function () {",
                      "  const quote = pm.response.json();",
                      "  pm.expect(quote.possible).to.equal(false);",
                      "  pm.expect(quote.totalBundles).to.equal(null);",
                      "  pm.expect(quote.bundles).to.deep.equal([]);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
