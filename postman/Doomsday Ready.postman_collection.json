                      "  const quote = pm.response.json();",
                      "  pm.expect(quote.possible).to.equal(true);",
                      "  pm.expect(quote.totalBundles).to.equal(4);",
                      "  pm.expect(quote.bundles.reduce((total, b) => total + b.size * b.quantity, 0)).to.equal(11);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Grand Cinema · 6, 9, 20 seats",
