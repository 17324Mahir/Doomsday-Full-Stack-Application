                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Grand Cinema {{run}}\",\n  \"bundleSizes\": [\n    6,\n    9,\n    20\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
